{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/theme.css",
      "destination": "/api/index.js"
    },
    {
      "source": "/theme/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
