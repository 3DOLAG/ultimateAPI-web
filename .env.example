# ===================================================
# RESELLER STORE CONFIGURATION
# ===================================================
PORT=3000
NODE_ENV=development
RESELLER_STORE_NAME="AURA Game"
RESELLER_TAGLINE="Digital Cards, Subscriptions & Game Licenses"
RESELLER_LOGO_URL=""
RESELLER_CURRENCY=EGP
RESELLER_CURRENCY_SYMBOL=EGP
SUPPORT_WHATSAPP="+201001234567"
SUPPORT_DISCORD="https://discord.gg/"
SUPPORT_TIKTOK="https://tiktok.com/@"

# ===================================================
# DISCORD OAUTH2 ADMIN AUTHENTICATION
# ===================================================
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"
ADMIN_DISCORD_ID=""

# Admin & Session Security
ADMIN_API_KEY=""
SESSION_SECRET="your-session-secret-key"
DEFAULT_PROFIT_MARGIN=15

# ===================================================
# SUPPLIER API CREDENTIALS
# ===================================================
SUPPLIER_API_URL=https://utimate-eg.com/api/v1
SUPPLIER_API_KEY=""
SUPPLIER_API_SECRET=""
SUPPLIER_WEBHOOK_SECRET=""

# Background sync schedule (Every 5 minutes)
SYNC_CRON_SCHEDULE="*/5 * * * *"
SYNC_ON_STARTUP=false

# Database and Storage
DATABASE_PATH=./data/reseller_store.db
UPLOAD_DIR=./uploads/proofs

# Discord Order Webhook (Server-Side Only)
DISCORD_ORDER_WEBHOOK_URL=""
